# Security headers — applied to all paths
# CSP is in report-only mode. After 1-2 weeks with no violations in the
# browser console, flip Content-Security-Policy-Report-Only to
# Content-Security-Policy to begin enforcing.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://analytics.ahrefs.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://*.google-analytics.com https://*.analytics.google.com https://analytics.ahrefs.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Prevent search engines from indexing the Cloudflare Pages preview host
https://alphabyte-ai.pages.dev/*
  X-Robots-Tag: noindex, nofollow
